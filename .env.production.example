# Floatly production settings. Copy to .env.production on the server and fill in.
# Never commit .env.production. Use letters and digits only in the passwords
# (they go inside database addresses); make each one at least 24 characters:
#   openssl rand -hex 24

# Your domain, pointed at this server (an A record). Caddy gets HTTPS for it.
DOMAIN=floatly.example.com

POSTGRES_PASSWORD=change-me
POS_OWNER_PASSWORD=change-me
POS_APP_PASSWORD=change-me

# Signs everyone's sign-in tokens. At least 32 characters: openssl rand -hex 32
JWT_SECRET=change-me-to-64-random-characters

# Cloudflare Tunnel only (running on your own computer): the token from
# Cloudflare → Networks → Tunnels → your tunnel. See DEPLOY.md, option B.
# TUNNEL_TOKEN=

# Optional
# API copies sharing the work; about one per CPU core on the server
# API_REPLICAS=2
# JWT_EXPIRES_IN=12h
# DATABASE_POOL_SIZE=20
# API_DOCS=false
# Requests per minute from one internet address (all tills in a shop share one)
# RATE_LIMIT=1200
