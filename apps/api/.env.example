# Runtime connection: the restricted role, subject to row-level security
DATABASE_URL=postgres://pos_app:pos_app@localhost:5432/pos
# Migrations connection: the table owner
MIGRATION_DATABASE_URL=postgres://pos_owner:pos_owner@localhost:5432/pos

PORT=4000
# Comma-separated list of web origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Generate a long random value for real deployments, e.g. `openssl rand -base64 48`
JWT_SECRET=dev-only-change-me-please-0123456789abcdef
JWT_EXPIRES_IN=12h
